# Local toolchain (prebuilt llama.cpp binaries, ~GBs)
tools/

# Model weights (GGUF, ~tens of GBs)
models/
__pycache__/
*.pyc

# SDD workspace (scratch, per-plan)
.superpowers/

# Staged sandbox bootstrap (generated copies of child.py + its two imports;
# the only directory granted to ALL APPLICATION PACKAGES -- see D7)
sandbox_bootstrap/

# Trace store: the DuckDB file, its blob tree, the parquet bundle, the
# per-launch server logs and the lifecycle JSONL (trace.db_path /
# trace.blob_root in config.yaml). Episode records are run output, never
# source -- and I4 makes them the sole episode truth, not something to
# reconstruct from a commit.
traces/

# S3 gate: generated per-run artifacts (trace store, per-run configs with
# dynamic fake-root ports). runs.jsonl and RESULTS.md are the record and are
# committed.
s3/results/store/
s3/results/cfg-*.yaml

# upstream bundle: keep the scripts, issue text and verification data;
# ignore stray bytecode
upstream/__pycache__/
