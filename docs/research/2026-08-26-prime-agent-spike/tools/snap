#!/usr/bin/env bash
# snap - harness-state snapshotter for the prime-agent local spike (plan section 5).
#
# RUNS INSIDE WSL, as the `spike` user, around every scored run.
#
#   snap pre  <dir> [session-hint]
#   snap post <dir> [session-hint]
#
# It copies and sha256s the two places a Continual-Harness refinement can land:
#
#   global : $PRIME_AGENT_CODING_AGENT_DIR/harness/          -> <dir>/harness.<phase>/global/
#   local  : <session-artifacts>/<session-id>/harness/       -> <dir>/harness.<phase>/local/
#
# and writes <dir>/harness.<phase>.sha256.  A pre/post difference is a
# model-initiated refinement (the A-refine reading); global entries that appear
# outside a planned /refine step are the ones to delete and log.
#
# Neither source has to exist.  A missing (or empty) source is recorded as an
# `# absent ...` / `# empty ...` comment line instead of failing, so `snap pre`
# on a fresh install and `snap` on a run that never refined both exit 0.
# Comment lines are ignored by `sha256sum -c`, so verification still works:
#
#   cd <dir>/harness.post && sha256sum -c ../harness.post.sha256
#
# Locating the LOCAL (per-session) harness dir - prime-agent only creates it
# once the session exists, so `snap pre` usually finds nothing:
#   1. session-hint argument, if given: a harness dir, a session-id dir, a bare
#      session id, a session-artifacts dir, or a --session-dir value (its
#      sibling session-artifacts/ is used, per plan section 3 step 4.7).
#   2. else $SNAP_ARTIFACTS_DIR, else the sibling of $SNAP_SESSION_DIR /
#      $PRIME_AGENT_SESSION_DIR, else $PRIME_AGENT_CODING_AGENT_DIR/session-artifacts.
#   3. with no explicit session id: `post` takes the most recently modified
#      <artifacts>/*/harness that is at least as new as <dir>/harness.pre.sha256
#      (i.e. touched by THIS run); `pre` records absent unless SNAP_LOCAL_ANY=1,
#      because the newest one there belongs to the PREVIOUS run and snapshotting
#      it would fake a pre/post difference.
# The chosen source path is written into the .sha256 header either way.
#
# Environment: PRIME_AGENT_CODING_AGENT_DIR (required for the global half;
# falls back to $HOME/prime-spike, which is what plan section 3 step 3 exports).
# Exit: 0 on success (absent sources included), 2 on bad usage or unwritable dir.

set -u

prog=${0##*/}

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 2; }

usage() {
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
  exit 0
}

case "${1:-}" in
  -h|--help|help|'') usage ;;
esac

phase=$1
case "$phase" in
  pre|post) ;;
  *) die "first argument must be 'pre' or 'post' (got '$phase')" ;;
esac

[ $# -ge 2 ] || die "usage: $prog pre|post <dir> [session-hint]"
dir=$2
hint=${3:-}

[ -d "$dir" ] || mkdir -p "$dir" || die "cannot create <dir>: $dir"
dir=$(cd "$dir" && pwd) || die "cannot enter <dir>: $2"

dest="$dir/harness.$phase"
manifest="$dir/harness.$phase.sha256"
pre_manifest="$dir/harness.pre.sha256"

rm -rf "$dest" || die "cannot clear $dest"
mkdir -p "$dest" || die "cannot create $dest"

# ---------------------------------------------------------------- global ----
agent_dir=${PRIME_AGENT_CODING_AGENT_DIR:-}
agent_note=""
if [ -z "$agent_dir" ]; then
  agent_dir="$HOME/prime-spike"
  agent_note=" (PRIME_AGENT_CODING_AGENT_DIR unset; assumed \$HOME/prime-spike)"
fi
global_src="$agent_dir/harness"

# ----------------------------------------------------------------- local ----
artifacts=""
local_src=""
local_note=""

resolve_hint() {
  h=$1
  case "$h" in
    */harness) [ -d "$h" ] && { local_src=$h; return 0; } ;;
  esac
  if [ -d "$h/harness" ]; then local_src="$h/harness"; return 0; fi
  if [ -d "$h" ] && [ "${h##*/}" = "session-artifacts" ]; then artifacts=$h; return 0; fi
  if [ -d "$h/session-artifacts" ]; then artifacts="$h/session-artifacts"; return 0; fi
  # a --session-dir value: artifacts live in its sibling
  if [ -d "$(dirname "$h")/session-artifacts" ]; then artifacts="$(dirname "$h")/session-artifacts"; return 0; fi
  # a bare session id
  case "$h" in
    */*) ;;
    *) sid=$h ;;
  esac
  return 1
}

sid=""
if [ -n "$hint" ]; then
  resolve_hint "$hint" || true
fi

if [ -z "$local_src" ] && [ -z "$artifacts" ]; then
  for cand in \
      "${SNAP_ARTIFACTS_DIR:-}" \
      "$(if [ -n "${SNAP_SESSION_DIR:-}" ]; then dirname "$SNAP_SESSION_DIR"; fi)/session-artifacts" \
      "$(if [ -n "${PRIME_AGENT_SESSION_DIR:-}" ]; then dirname "$PRIME_AGENT_SESSION_DIR"; fi)/session-artifacts" \
      "$agent_dir/session-artifacts" ; do
    case "$cand" in ''|/session-artifacts) continue ;; esac
    if [ -d "$cand" ]; then artifacts=$cand; break; fi
  done
fi

if [ -z "$local_src" ] && [ -n "$artifacts" ]; then
  if [ -n "$sid" ]; then
    if [ -d "$artifacts/$sid/harness" ]; then
      local_src="$artifacts/$sid/harness"
    else
      local_note=" (no $artifacts/$sid/harness)"
    fi
  elif [ "$phase" = "post" ] || [ "${SNAP_LOCAL_ANY:-0}" = "1" ]; then
    newest=""
    for h in "$artifacts"/*/harness; do
      [ -d "$h" ] || continue
      if [ "$phase" = "post" ] && [ "${SNAP_LOCAL_ANY:-0}" != "1" ] && [ -f "$pre_manifest" ] \
         && [ "$h" -ot "$pre_manifest" ]; then
        continue
      fi
      if [ -z "$newest" ] || [ "$h" -nt "$newest" ]; then newest=$h; fi
    done
    if [ -n "$newest" ]; then
      local_src=$newest
    else
      local_note=" (no session harness under $artifacts newer than harness.pre.sha256)"
    fi
  else
    local_note=" (pre with no session id: the current session does not exist yet; set SNAP_LOCAL_ANY=1 to snapshot the newest anyway)"
  fi
elif [ -z "$local_src" ]; then
  local_note=" (no session-artifacts dir found; pass one as the third argument or set SNAP_ARTIFACTS_DIR)"
fi

# ------------------------------------------------------------------ copy ----
copy_one() {   # copy_one <src> <name>  -> echoes a header comment
  src=$1; name=$2; note=$3
  if [ -z "$src" ]; then
    printf '# absent %s%s\n' "$name" "$note"
    return 0
  fi
  if [ ! -d "$src" ]; then
    printf '# absent %s %s%s\n' "$name" "$src" "$note"
    return 0
  fi
  if [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
    printf '# empty %s %s\n' "$name" "$src"
    return 0
  fi
  mkdir -p "$dest/$name" || die "cannot create $dest/$name"
  if cp -a "$src/." "$dest/$name/" 2>/dev/null; then
    printf '# %s source: %s\n' "$name" "$src"
  else
    rm -rf "${dest:?}/$name"
    printf '# unreadable %s %s\n' "$name" "$src"
  fi
}

hdr_global=$(copy_one "$global_src" global "$agent_note")
hdr_local=$(copy_one "$local_src" local "$local_note")

# -------------------------------------------------------------- manifest ----
{
  printf '# snap %s %s\n' "$phase" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '# dir: %s\n' "$dir"
  printf '# host: %s user: %s\n' "$(hostname 2>/dev/null || echo '?')" "$(id -un 2>/dev/null || echo '?')"
  printf '%s\n' "$hdr_global"
  printf '%s\n' "$hdr_local"
  ( cd "$dest" && find . -type f -print 2>/dev/null | sed 's|^\./||' | LC_ALL=C sort \
      | while IFS= read -r f; do sha256sum "$f"; done )
} > "$manifest" || die "cannot write $manifest"

files=$(grep -c '^[0-9a-f]\{64\}  ' "$manifest" 2>/dev/null || true)
[ -n "$files" ] || files=0
printf '%s %s: %s files -> %s\n' "$prog" "$phase" "$files" "$manifest"
exit 0
